.venv/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
# Databases and their WAL/SHM sidecars, wherever they land
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite
*.db

# Runtime state: pid files and logs from scripts/start_dev.sh
.run/
*.log

# Build output
frontend/dist/
frontend/node_modules/
build/
dist/
*.egg-info/

# Environment and secrets. Never commit real credentials.
.env
.env.*
!.env.example
# The deploy directory has its own env file; the example is tracked, the real one is not.
deploy/.env
!deploy/.env.example

# Editors and OS cruft
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

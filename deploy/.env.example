# 私有化部署环境变量范例。复制为 deploy/.env 后填入真实值。
#
# 这份文件里**没有任何可用的默认值**——每一项都必须自己填。带默认口令的范例文件
# 最终总会被原样部署，而 `aletheia preflight` 恰好会拦下 change-me 这类占位值。

# -- 平台库（PostgreSQL） --
# 不要用 SQLite 跑多工作进程：SQLite 串行化写入，高并发下表现为间歇性超时。
POSTGRES_DB=ontology
POSTGRES_USER=ontology
POSTGRES_PASSWORD=

# -- 引导管理员 --
# 至少 12 位随机口令。preflight 会检查长度并拒绝常见占位值。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(18))"
ONTOLOGY_ADMIN_PASSWORD=

# -- CORS --
# 逐个列出前端来源，逗号分隔。`*` 会被 preflight 拦下：
# 任意站点都能携带用户凭据驱动本 API。
ONTOLOGY_ALLOWED_ORIGINS=https://ontology.example.com

# -- 会话 --
# 令牌泄露后的暴露窗口就是这个值。
ONTOLOGY_SESSION_TTL_HOURS=12

# -- 请求限流 --
# 默认**不限制**：合适的额度取决于你的流量，这个数字平台猜不出来。
# 不设置时单个调用方可以无上限地产生请求，且没有任何日志会记录「哪些请求没被限流」——
# 第一个征兆是服务被打垮。`aletheia preflight` 会对此给出 warning。
# 计数按进程独立：多 worker 时实际额度 = 该值 × worker 数。
# 同一 NAT 后的全部用户共用一个额度，按人群规模设置。
ONTOLOGY_RATE_LIMIT_PER_MINUTE=600
# 登录／SSO 接口单独计数，默认 10。保护的是口令而非带宽：每分钟试几个口令，
# 几个月后依然会成功，所以这一项远比整体限额严。
ONTOLOGY_RATE_LIMIT_AUTH_PER_MINUTE=10

# -- 日志 --
# 默认写 stderr 并交给运行时收集（docker logs）。要落盘则设 ONTOLOGY_LOG_FILE，
# 目录会自动创建，按 10 MiB × 5 轮转。
# ONTOLOGY_LOG_FILE=/var/log/aletheia/platform.log
# 交给日志聚合系统解析时开启 JSON（每行一个对象，含 requestId 字段）。
ONTOLOGY_LOG_FORMAT=json
ONTOLOGY_LOG_LEVEL=INFO

# -- 监听地址 --
# 默认只绑本机，前置反向代理负责 TLS。
# 要直接对外暴露时改为 0.0.0.0，但请确认已配置 TLS 终止。
ONTOLOGY_BIND=127.0.0.1

# -- 可选监控（`--profile monitoring`） --
# 不启用监控时无需填写。启用 Grafana 时必须显式设置口令。
GRAFANA_ADMIN_PASSWORD=

# -- 模型层（可选） --
# 平台在没有模型时也能产出判定（走本地启发式），因此这一项可以留空。
# 若要配置，优先通过平台的模型配置接口存储（会被脱敏），
# 而不是放在环境变量里——环境变量会进入崩溃转储与容器 inspect。
# OPENROUTER_API_KEY=
# 也支持 DeepSeek 官方 API（OpenAI 兼容协议）：若未设置 OPENROUTER_API_KEY，
# 设置 DEEPSEEK_API_KEY 后会自动使用 https://api.deepseek.com + deepseek-flash。
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
